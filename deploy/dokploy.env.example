# Public hostname routed by Dokploy's Traefik proxy.
PATCHFORGE_DOMAIN=updates.example.com

# Generate with: openssl rand -hex 32
PATCHFORGE_DB_PASSWORD=replace-with-a-random-database-password

# Stable identifier for the Ed25519 signing key mounted below.
PATCHFORGE_KEY_ID=main-20261013

# SHA-256 of the raw publisher token, never the raw token itself.
PATCHFORGE_PUBLISH_TOKEN_HASHES=replace-with-a-64-character-sha256-hash

# Pin this to a release tag in production.
PATCHFORGE_SERVER_IMAGE=ghcr.io/kaung-myat/patchforge-server:0.6.2

# Persistent resources prepared on the Dokploy host.
PATCHFORGE_POSTGRES_VOLUME=patchforge_postgres_data
PATCHFORGE_PRIVATE_KEY_FILE=/opt/patchforge/secrets/signing-private-key
PATCHFORGE_STORAGE_DIR=/opt/patchforge/storage

# Maximum accepted patch upload size (100 MiB by default).
PATCHFORGE_MAX_ARTIFACT_SIZE_BYTES=104857600
