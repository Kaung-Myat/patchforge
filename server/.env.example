DATABASE_URL=postgres://patchforge:replace-me@localhost:5433/patchforge
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
PATCHFORGE_KEY_ID=main-key-id
PATCHFORGE_PRIVATE_KEY=base64-encoded-ed25519-private-key
# Preferred in production. When set, this file takes precedence over the value
# above and should be mounted by the runtime secret manager.
# PATCHFORGE_PRIVATE_KEY_FILE=/run/secrets/patchforge_private_key

# Generate the next pair in a secret manager before rotation. Publish an
# old-key-signed bridge that bundles only the next public key before promoting
# the next private key to PATCHFORGE_PRIVATE_KEY.

# Comma-separated SHA-256 hashes support zero-downtime publisher-token rotation.
PATCHFORGE_PUBLISH_TOKEN_HASHES=sha256-hex-of-publisher-token

# Edge security. Keep TRUST_PROXY=false unless traffic can only arrive through
# the configured reverse proxy.
PATCHFORGE_TRUST_PROXY=false
PATCHFORGE_HTTPS_ENABLED=false
PATCHFORGE_PUBLIC_RATE_LIMIT_PER_MINUTE=120
PATCHFORGE_ARTIFACT_RATE_LIMIT_PER_MINUTE=300
PATCHFORGE_MANAGEMENT_RATE_LIMIT_PER_MINUTE=60
PATCHFORGE_REQUEST_TIMEOUT_SECONDS=120
